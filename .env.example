# ============================================================
# Corbell — Environment Variables
# Copy this file to .env and fill in the values you need.
# ============================================================

# ----------------------------------------------------------
# LLM Provider API Keys (pick one or more)
# ----------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Multiple Google keys for round-robin: GOOGLE_API_KEY=key1,key2,key3

# AWS Bedrock
BEDROCK_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-01

# GCP Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT=
GOOGLE_CLOUD_PROJECT=
GCP_REGION=us-central1

# Generic fallback key (used when provider-specific key is not set)
CORBELL_LLM_API_KEY=

# ----------------------------------------------------------
# Model Overrides (override workspace.yaml without editing it)
# ----------------------------------------------------------

# Embedding model (overrides storage.model in workspace.yaml)
CORBELL_EMBEDDING_MODEL=

# LLM model — generic (overrides llm.model in workspace.yaml)
CORBELL_LLM_MODEL=

# LLM model — provider-specific (takes priority over CORBELL_LLM_MODEL)
ANTHROPIC_MODEL=
OPENAI_MODEL=
GOOGLE_MODEL=
OLLAMA_MODEL=
AWS_MODEL=
AZURE_MODEL=
GCP_MODEL=

# ----------------------------------------------------------
# Workspace Path (required if --workspace is not passed to CLI)
# ----------------------------------------------------------

# Full path to workspace.yaml or its parent directory
CORBELL_WORKSPACE=
